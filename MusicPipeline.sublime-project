{
    "folders": [
		{
	    "path": "."
		}
	],
	"debugger_configurations": [
		{
			"name": "C# (.NET Core)",
			"type": "coreclr",
			"request": "launch",
			"command": "netcoredbg", // Or absolute path like "C:/netcoredbg/netcoredbg.exe"
			"args": ["--engineLogging"],
			"program": "${folder}/src/MusicPipeline/bin/Debug/net10.0/MusicPipeline.dll", // Adjust target framework/dll name
			"cwd": "${folder}",
			"stopAtEntry": false
		}
	]
}